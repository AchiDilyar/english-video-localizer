{
  "default_style": "clean",
  "default_layout": "zh_top",
  "resolutions": [
    480,
    720,
    1080,
    1440,
    2160
  ],
  "layouts": {
    "zh_only": {
      "label": "仅译文",
      "lines": [
        "zh"
      ],
      "margin_y": {
        "zh": 80
      },
      "font": "MiSans Medium"
    },
    "zh_top": {
      "label": "双语 · 译文在上",
      "lines": [
        "zh",
        "en"
      ],
      "margin_y": {
        "zh": 165,
        "en": 70
      },
      "font": "MiSans Medium"
    },
    "zh_bottom": {
      "label": "双语 · 译文在下",
      "lines": [
        "en",
        "zh"
      ],
      "margin_y": {
        "zh": 60,
        "en": 180
      },
      "font": "MiSans"
    }
  },
  "styles": {
    "clean": {
      "label": "默认样式"
    },
    "contrast": {
      "label": "高对比底框",
      "font": "MiSans Medium",
      "zh_edge": "#10151de0",
      "en_edge": "#10151de0",
      "zh_outline": 8,
      "en_outline": 8,
      "box": true
    },
    "serif": {
      "label": "宋体细描边",
      "font": "Songti SC",
      "zh_edge": "#272018",
      "en_edge": "#272018",
      "zh_outline": 4,
      "en_outline": 3.5
    },
    "refined": {
      "label": "简约精致",
      "font": "MiSans Demibold",
      "zh_edge": "#000000",
      "en_edge": "#000000",
      "zh_outline": 1,
      "en_outline": 1,
      "zh_background": "#000000ef",
      "en_background": "#000000",
      "shadow": 6
    }
  },
  "geometry": {
    "width": 3840,
    "height": 2160,
    "margin_x": 220,
    "zh_size": 130,
    "en_size": 100,
    "alignment": 2,
    "wrap_style": 2
  },
  "appearance": {
    "color": "#ffffff",
    "secondary": "#ffe7ad",
    "background": "#0000007f",
    "zh_edge": "#071124",
    "en_edge": "#000000",
    "zh_outline": 7,
    "en_outline": 6.5,
    "shadow": 0,
    "box": false
  }
}
