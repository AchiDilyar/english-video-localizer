DEEPSEEK_API_KEY=
# OpenAI-compatible gateway, e.g. https://gateway.example.org/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set DEEPSEEK_MODEL to a model identifier actually provided by your gateway.
# DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE=
DASHSCOPE_REGION=ap-southeast-1
# api uses DEEPSEEK_API_KEY; school_bridge needs an authorized external operator.
DEEPSEEK_TRANSPORT=api
# DEEPSEEK_BRIDGE_DIR=/local/path/to/bridge
# LOCALIZER_NODE_PATH=/path/to/node
HF_TOKEN=
